{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "DoomAgent",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "DoomAgent"
  },
  "runtimes": [
    {
      "name": "DoomAgentV2",
      "build": "Container",
      "entrypoint": "main.py",
      "codeLocation": "app/DoomAgent/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "DOOM_MEMORY_ID",
          "value": "${DoomMapMemory.memoryId}"
        }
      ],
      "additionalPolicies": [
        "doom-memory-policy.json"
      ]
    }
  ],
  "memories": [
    {
      "name": "DoomMapMemory",
      "eventExpiryDuration": 90,
      "strategies": []
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}